{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority",
    "DatabaseName": "SolarMicrogridTradingSystem"
  },
  "JwtSettings": {
    "Secret": "<replace-with-a-long-random-secret>",
    "Issuer": "SmartSolarMicrogridTradingSystem",
    "Audience": "SmartSolarMicrogridTradingSystem"
  }
}
